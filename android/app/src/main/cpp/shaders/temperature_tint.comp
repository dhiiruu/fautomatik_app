#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputBuf { uint pixels[]; } inputBuf;
layout(set = 0, binding = 1) writeonly buffer OutputBuf { uint pixels[]; } outputBuf;
layout(set = 0, binding = 2) uniform Params {
    float temperature;    // -1.0 to 1.0 (cool to warm)
    float tint;           // -1.0 to 1.0 (green to magenta)
    float _pad0;
    float _pad1;
} params;

float srgbToLinear(float v) {
    if (v <= 0.04045) return v / 12.92;
    return pow((v + 0.055) / 1.055, 2.4);
}

float linearToSrgb(float v) {
    if (v <= 0.0031308) return v * 12.92;
    return 1.055 * pow(v, 1.0 / 2.4) - 0.055;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint width = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    uint height = gl_NumWorkGroups.y * gl_WorkGroupSize.y;

    if (x >= width || y >= height) return;

    uint idx = y * width + x;
    uint packed = inputBuf.pixels[idx];

    float r = float((packed >> 24) & 0xFF) / 255.0;
    float g = float((packed >> 16) & 0xFF) / 255.0;
    float b = float((packed >> 8)  & 0xFF) / 255.0;
    float a = float(packed & 0xFF) / 255.0;

    // Convert to linear space for color grading
    r = srgbToLinear(r);
    g = srgbToLinear(g);
    b = srgbToLinear(b);

    // Temperature adjustment (blue <-> orange)
    // Negative = cooler (more blue), Positive = warmer (more orange/red)
    // Based on blackbody radiation curve approximation
    float tempAdjust = params.temperature * 0.5; // Scale to reasonable range
    
    if (tempAdjust > 0.0) {
        // Warmer: increase red/orange, decrease blue
        r *= 1.0 + tempAdjust * 0.6;
        g *= 1.0 + tempAdjust * 0.2;
        b *= 1.0 - tempAdjust * 0.8;
    } else {
        // Cooler: decrease red/orange, increase blue
        r *= 1.0 + tempAdjust * 0.8;
        g *= 1.0 + tempAdjust * 0.2;
        b *= 1.0 - tempAdjust * 0.6;
    }

    // Tint adjustment (green <-> magenta)
    // Negative = more green, Positive = more magenta
    float tintAdjust = params.tint * 0.4; // Scale to reasonable range
    
    if (tintAdjust > 0.0) {
        // More magenta: increase red and blue, decrease green
        r *= 1.0 + tintAdjust * 0.4;
        g *= 1.0 - tintAdjust * 0.6;
        b *= 1.0 + tintAdjust * 0.4;
    } else {
        // More green: decrease red and blue, increase green
        r *= 1.0 + tintAdjust * 0.4;
        g *= 1.0 - tintAdjust * 0.6;
        b *= 1.0 + tintAdjust * 0.4;
    }

    // Clamp to prevent overflow
    r = clamp(r, 0.0, 1.0);
    g = clamp(g, 0.0, 1.0);
    b = clamp(b, 0.0, 1.0);

    // Convert back to sRGB
    r = linearToSrgb(r);
    g = linearToSrgb(g);
    b = linearToSrgb(b);

    uint ri = uint(r * 255.0 + 0.5);
    uint gi = uint(g * 255.0 + 0.5);
    uint bi = uint(b * 255.0 + 0.5);
    uint ai = uint(a * 255.0 + 0.5);

    outputBuf.pixels[idx] = (ri << 24) | (gi << 16) | (bi << 8) | ai;
}
