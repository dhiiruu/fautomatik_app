#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputBuf { uint pixels[]; } inputBuf;
layout(set = 0, binding = 1) writeonly buffer OutputBuf { uint pixels[]; } outputBuf;
layout(set = 0, binding = 2) uniform Params {
    float highlights;     // -1.0 to 1.0 (darken to brighten highlights)
    float shadows;        // -1.0 to 1.0 (darken to brighten shadows)
    float whites;         // -1.0 to 1.0 (adjust white point)
    float blacks;         // -1.0 to 1.0 (adjust black point)
} params;

float srgbToLinear(float v) {
    if (v <= 0.04045) return v / 12.92;
    return pow((v + 0.055) / 1.055, 2.4);
}

float linearToSrgb(float v) {
    if (v <= 0.0031308) return v * 12.92;
    return 1.055 * pow(v, 1.0 / 2.4) - 0.055;
}

// Smoothstep-based tone mapping for highlights/shadows
float applyToneRange(float channel, float luminance, float rangeAdjust, bool isHighlight) {
    if (rangeAdjust == 0.0) return channel;
    
    float target;
    float weight;
    
    if (isHighlight) {
        // Highlights: affect bright areas (luminance > 0.5)
        target = 1.0;
        weight = smoothstep(0.5, 1.0, luminance);
        // Positive = brighten, Negative = darken
        float adjustment = rangeAdjust * weight * (target - channel);
        return channel + adjustment;
    } else {
        // Shadows: affect dark areas (luminance < 0.5)
        target = 0.0;
        weight = smoothstep(0.5, 0.0, luminance);
        // Positive = brighten, Negative = darken
        float adjustment = rangeAdjust * weight * (target - channel);
        return channel + adjustment;
    }
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint width = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    uint height = gl_NumWorkGroups.y * gl_WorkGroupSize.y;

    if (x >= width || y >= height) return;

    uint idx = y * width + x;
    uint packed = inputBuf.pixels[idx];

    float r = float((packed >> 24) & 0xFF) / 255.0;
    float g = float((packed >> 16) & 0xFF) / 255.0;
    float b = float((packed >> 8)  & 0xFF) / 255.0;
    float a = float(packed & 0xFF) / 255.0;

    // Convert to linear space
    r = srgbToLinear(r);
    g = srgbToLinear(g);
    b = srgbToLinear(b);

    // Calculate luminance for selective adjustments
    float lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;

    // Apply highlights adjustment (affects bright areas)
    r = applyToneRange(r, lum, params.highlights, true);
    g = applyToneRange(g, lum, params.highlights, true);
    b = applyToneRange(b, lum, params.highlights, true);

    // Apply shadows adjustment (affects dark areas)
    r = applyToneRange(r, lum, params.shadows, false);
    g = applyToneRange(g, lum, params.shadows, false);
    b = applyToneRange(b, lum, params.shadows, false);

    // Apply whites (adjust white point - affects very bright areas)
    float whitesFactor = 1.0 + params.whites * 0.3;
    float whiteWeight = smoothstep(0.7, 1.0, max(max(r, g), b));
    r = mix(r, clamp(r * whitesFactor, 0.0, 1.0), whiteWeight);
    g = mix(g, clamp(g * whitesFactor, 0.0, 1.0), whiteWeight);
    b = mix(b, clamp(b * whitesFactor, 0.0, 1.0), whiteWeight);

    // Apply blacks (adjust black point - affects very dark areas)
    float blacksFactor = 1.0 + params.blacks * 0.3;
    float blackWeight = smoothstep(0.3, 0.0, min(min(r, g), b));
    r = mix(r, clamp(r * blacksFactor, 0.0, 1.0), blackWeight);
    g = mix(g, clamp(g * blacksFactor, 0.0, 1.0), blackWeight);
    b = mix(b, clamp(b * blacksFactor, 0.0, 1.0), blackWeight);

    // Clamp to valid range
    r = clamp(r, 0.0, 1.0);
    g = clamp(g, 0.0, 1.0);
    b = clamp(b, 0.0, 1.0);

    // Convert back to sRGB
    r = linearToSrgb(r);
    g = linearToSrgb(g);
    b = linearToSrgb(b);

    uint ri = uint(r * 255.0 + 0.5);
    uint gi = uint(g * 255.0 + 0.5);
    uint bi = uint(b * 255.0 + 0.5);
    uint ai = uint(a * 255.0 + 0.5);

    outputBuf.pixels[idx] = (ri << 24) | (gi << 16) | (bi << 8) | ai;
}
