#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputBuf { uint pixels[]; } inputBuf;
layout(set = 0, binding = 1) writeonly buffer OutputBuf { uint pixels[]; } outputBuf;
layout(set = 0, binding = 2) uniform Params {
    float sharpness;      // 0.0 to 1.0 (none to maximum)
    float radius;         // 1.0 to 3.0 (blur radius for unsharp mask)
    float threshold;      // 0.0 to 0.5 (minimum difference to apply sharpening)
    float _pad0;
} params;

float srgbToLinear(float v) {
    if (v <= 0.04045) return v / 12.92;
    return pow((v + 0.055) / 1.055, 2.4);
}

float linearToSrgb(float v) {
    if (v <= 0.0031308) return v * 12.92;
    return 1.055 * pow(v, 1.0 / 2.4) - 0.055;
}

// Sample neighboring pixels for blur
vec3 getPixel(uint idx) {
    uint packed = inputBuf.pixels[idx];
    float r = float((packed >> 24) & 0xFF) / 255.0;
    float g = float((packed >> 16) & 0xFF) / 255.0;
    float b = float((packed >> 8)  & 0xFF) / 255.0;
    return vec3(srgbToLinear(r), srgbToLinear(g), srgbToLinear(b));
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint width = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    uint height = gl_NumWorkGroups.y * gl_WorkGroupSize.y;

    if (x >= width || y >= height) return;

    uint idx = y * width + x;
    uint packed = inputBuf.pixels[idx];
    float a = float(packed & 0xFF) / 255.0;

    int radiusInt = int(clamp(params.radius, 1.0, 3.0));
    float sharpAmount = params.sharpness;
    float thresh = params.threshold;

    // Get center pixel in linear space
    vec3 center = getPixel(idx);

    // Apply Gaussian-like blur for unsharp mask
    vec3 blurred = vec3(0.0);
    float totalWeight = 0.0;

    for (int dy = -radiusInt; dy <= radiusInt; dy++) {
        for (int dx = -radiusInt; dx <= radiusInt; dx++) {
            int sx = clamp(int(x) + dx, 0, int(width) - 1);
            int sy = clamp(int(y) + dy, 0, int(height) - 1);
            
            float dist = float(dx * dx + dy * dy);
            float weight = exp(-dist / (2.0 * float(radiusInt) * float(radiusInt)));
            
            blurred += getPixel(uint(sy) * width + uint(sx)) * weight;
            totalWeight += weight;
        }
    }

    blurred /= totalWeight;

    // Unsharp mask: sharpened = original + amount * (original - blurred)
    vec3 diff = center - blurred;

    // Only apply if difference exceeds threshold (prevents noise amplification)
    float diffMagnitude = length(diff);
    float applyFactor = diffMagnitude > thresh ? sharpAmount : 0.0;

    vec3 sharpened = center + diff * applyFactor;

    // Clamp to valid range
    sharpened = clamp(sharpened, 0.0, 1.0);

    // Convert back to sRGB
    float r = linearToSrgb(sharpened.r);
    float g = linearToSrgb(sharpened.g);
    float b = linearToSrgb(sharpened.b);

    uint ri = uint(r * 255.0 + 0.5);
    uint gi = uint(g * 255.0 + 0.5);
    uint bi = uint(b * 255.0 + 0.5);
    uint ai = uint(a * 255.0 + 0.5);

    outputBuf.pixels[idx] = (ri << 24) | (gi << 16) | (bi << 8) | ai;
}
